	partition Tickets = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\tickets.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"ticket_id", Int64.Type}, {"created_date", type date}, {"project", type text}, {"priority", type text}, {"final_status", type text}, {"status_eligible", Int64.Type}, {"assignment_eligible", Int64.Type}, {"resolution_days", type number}, {"observed_status_days", type number}, {"waiting_days", type number}, {"waiting_entries", Int64.Type}, {"validation_returns", Int64.Type}, {"reopen_entries", Int64.Type}, {"named_handoffs", Int64.Type}}, "en-US"),
				    Priority = Table.TransformColumns(Typed, {{"priority", each if _ = "unknown" then "Unknown" else _, type text}}),
				    WithPriorityOrder = Table.AddColumn(Priority, "priority_order", each List.PositionOf({"Blocker", "Highest", "High", "Medium", "Low", "Lowest", "Unknown"}, [priority]) + 1, Int64.Type)
				in
				    WithPriorityOrder

	annotation PBI_ResultType = Table
